{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SealSuite",
  "version": "../package.json",
  "identifier": "com.mkiera.sealsuite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SealSuite",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "mkiera",
    "copyright": "Copyright (C) 2026 mkiera",
    "shortDescription": "Manages the SealSuite apps",
    "category": "Utility",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/mkiera/SealSuite",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
